# Proxmox VE Dashboard Configuration
PORT=3333
NODE_ENV=production

# PVE Connection Info (Only this is needed!)
PVE_HOST=192.168.2.5
PVE_PORT=8006
PVE_TOKEN_ID=root@pam!dashboard
PVE_TOKEN_SECRET=your-token-secret-uuid
PVE_VERIFY_SSL=false

# Optional fallback: SSH credentials (NOT needed if setup-pve-thermal.sh is used)
PVE_SSH_USER=
PVE_SSH_PASSWORD=
