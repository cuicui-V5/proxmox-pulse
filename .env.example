# Proxmox VE Dashboard Configuration
PORT=3333
NODE_ENV=production

# PVE Connection Info
PVE_HOST=192.168.2.5
PVE_PORT=8006
PVE_TOKEN_ID=root@pam!dashboard
PVE_TOKEN_SECRET=your-token-secret-uuid
PVE_VERIFY_SSL=false

# PVE Host SSH (Optional, for CPU Temperature sensor monitoring)
PVE_SSH_HOST=192.168.2.5
PVE_SSH_PORT=22
PVE_SSH_USER=root
PVE_SSH_PASSWORD=your-ssh-password
